# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Adsense & Google Ads Configuration
VITE_GOOGLE_ADS_CLIENT="ca-pub-6107404977656872"
PUBLIC_GOOGLE_ADSENSE_CLIENT_ID="ca-pub-6107404977656872"
PUBLIC_GOOGLE_ADS_SLOT_TOP=""
PUBLIC_GOOGLE_ADS_SLOT_BOTTOM=""

# SMTP Credentials & Configuration (contact form sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@sejourtaxe.com
SMTP_PASS=
CONTACT_TO_EMAIL=contact@sejourtaxe.com
CONTACT_FROM_EMAIL=contact@sejourtaxe.com

# Site configuration & GDPR
VITE_SITE_VERSION=1.0.0
VITE_ENABLE_COOKIE_BANNER=true

# Optional Social Media links (leave empty to hide)
VITE_TWITTER_URL=
VITE_LINKEDIN_URL=
VITE_FACEBOOK_URL=


